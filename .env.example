# Admin gate (required for local use — change this)
ADMIN_PASSWORD=change-me-please

# Optional: restrict access by IP (comma-separated). Leave empty to allow all.
# Example: ALLOW_IPS=127.0.0.1,::1
ALLOW_IPS=

# true disables cloning on this environment
READ_ONLY=false

# Mermaid ER diagram button
DIAGRAM_ENABLED=true

# Optional Step 1 defaults (no secrets — password is entered in the UI)
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=3306
DEFAULT_DB_USER=

# Optional: point to mysqldump if not in PATH
# Windows WAMP example:
# MYSQLDUMP_PATH=C:\wamp64\bin\mysql\mysql8.0.36\bin\mysqldump.exe
# Linux/cPanel example:
# MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQLDUMP_PATH=
